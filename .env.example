# Copy to .env and fill in real values. .env is gitignored - never commit it.

# ---- Shared (dev infra compose + production stack) ----
# SQL Server SA password (min 8 chars, upper+lower+digit+symbol per MSSQL policy)
MSSQL_SA_PASSWORD=Change_Me_123!

# ---- Dev infra compose (docker-compose.yml) only ----
MSSQL_PORT=1433
REDIS_PORT=6379
KAFKA_PORT=9092

# ---- Production stack (docker-compose.prod.yml) only ----
# JWT signing secret (generate: openssl rand -base64 48)
JWT_SECRET=

# The one account that cannot be created through the UI: the initial platform
# operator. Seeded idempotently on first API start; hospitals are then
# onboarded through the UI after logging in with this account.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Host port the frontend (the only exposed service) binds to.
FRONTEND_PORT=8081

# Optional: Application Insights connection string. Leave empty to run without
# telemetry (OpenTelemetry only activates when this is set).
APPINSIGHTS_CONNECTION_STRING=
